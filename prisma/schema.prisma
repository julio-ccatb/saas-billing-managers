// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id             String          @id @default(cuid())
    name           String?
    email          String?         @unique
    emailVerified  DateTime?
    image          String?
    passwordHash   String?
    userRole       String          @default("OPERATOR") // OPERATOR, CLIENT
    accounts       Account[]
    sessions       Session[]
    posts          Post[]
    companyMembers CompanyMember[]
    customers      Customer[]      @relation("OperatorCustomers")
    clientProfile  Customer?       @relation("ClientUser")
    invoices       Invoice[]
    licenses       License[]
    contracts      Contract[]
    auditLogs      AuditLog[]
    receiptsUploaded PaymentReceipt[]
}

model Company {
    id                String          @id @default(cuid())
    name              String
    email             String          @default("")
    phone             String          @default("")
    address           String          @default("")
    city              String          @default("")
    zipCode           String          @default("")
    country           String          @default("")
    taxId             String          @default("")
    bankName          String          @default("")
    bankAccountName   String          @default("")
    bankAccountNumber String          @default("")
    logoUrl           String?
    signatureData     String?
    currency          String          @default("USD")
    paymentTerms      String          @default("Payment due upon receipt")
    notes             String          @default("Thank you for your business!")
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt

    members           CompanyMember[]
    customers         Customer[]
    invoices          Invoice[]
    contracts         Contract[]
    licenses          License[]
    auditLogs         AuditLog[]

    @@index([name])
}

model CompanyMember {
    id        String   @id @default(cuid())
    companyId String
    userId    String
    role      String   @default("OWNER") // OWNER, ADMIN, MEMBER
    createdAt DateTime @default(now())

    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([companyId, userId])
    @@index([userId])
}

model Customer {
    id            String    @id @default(cuid())
    companyId     String
    userId        String
    clientUserId  String?   @unique
    portalEnabled Boolean   @default(false)
    name          String
    email         String    @default("")
    phone         String    @default("")
    address       String    @default("")
    city          String    @default("")
    zipCode       String    @default("")
    country       String    @default("")
    taxId         String    @default("")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user          User      @relation("OperatorCustomers", fields: [userId], references: [id], onDelete: Cascade)
    clientUser    User?     @relation("ClientUser", fields: [clientUserId], references: [id], onDelete: SetNull)
    invoices      Invoice[]
    licenses      License[]
    contracts     Contract[]
    receipts      PaymentReceipt[]

    @@index([companyId, name])
    @@index([userId])
}

model Invoice {
    id              String        @id @default(cuid())
    companyId       String
    userId          String
    customerId      String?
    invoiceNumber   String
    issueDate       DateTime      @default(now())
    dueDate         DateTime
    status          String        @default("PENDING") // DRAFT, PENDING, PAYMENT_PENDING_VERIFICATION, PAID, OVERDUE
    currency        String        @default("USD")

    // Sender details snapshotted at time of invoice
    senderName      String        @default("")
    senderEmail     String        @default("")
    senderPhone     String        @default("")
    senderAddress   String        @default("")
    senderCity      String        @default("")
    senderZipCode   String        @default("")
    senderCountry   String        @default("")
    senderTaxId     String        @default("")

    // Receiver details snapshotted
    receiverName    String        @default("")
    receiverEmail   String        @default("")
    receiverPhone   String        @default("")
    receiverAddress String        @default("")
    receiverCity    String        @default("")
    receiverZipCode String        @default("")
    receiverCountry String        @default("")
    receiverTaxId   String        @default("")

    // Calculations
    subTotal        Float         @default(0)
    taxRate         Float         @default(0)
    taxAmount       Float         @default(0)
    discountRate    Float         @default(0)
    discountAmount  Float         @default(0)
    shippingAmount  Float         @default(0)
    totalAmount     Float         @default(0)

    notes           String        @default("")
    paymentTerms    String        @default("")
    bankName        String        @default("")
    bankAccountName String        @default("")
    bankAccountNumber String      @default("")
    templateId      String        @default("classic")
    themeColor      String        @default("#4F46E5")
    logoUrl         String?
    signatureData   String?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt

    company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
    items           InvoiceItem[]
    receipts        PaymentReceipt[]

    @@index([companyId, status])
    @@index([companyId, invoiceNumber])
    @@index([userId])
}

model InvoiceItem {
    id          String   @id @default(cuid())
    invoiceId   String
    description String
    quantity    Float    @default(1)
    unitPrice   Float    @default(0)
    total       Float    @default(0)
    orderIndex  Int      @default(0)

    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    @@index([invoiceId])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model License {
    id               String    @id @default(cuid())
    companyId        String
    userId           String
    customerId       String?
    name             String
    key              String    @unique
    status           String    @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
    allowedDomain    String?
    suspensionNotice String?
    leaseTtlMinutes  Int       @default(60)
    gracePeriodHours Int       @default(3)
    lastCheckedAt    DateTime?
    lastCheckedIp    String?
    checkCount       Int       @default(0)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

    @@index([companyId, status])
    @@index([userId])
    @@index([key])
}

model Contract {
    id             String    @id @default(cuid())
    companyId      String
    userId         String
    customerId     String
    contractNumber String
    title          String
    status         String    @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, TERMINATED
    value          Float     @default(0)
    currency       String    @default("USD")
    billingCycle   String    @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUALLY, ONE_TIME
    startDate      DateTime  @default(now())
    endDate        DateTime?
    signedAt       DateTime?
    terms          String    @default("")
    notes          String    @default("")
    submissionId   Int?
    signedDocumentUrl String?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

    @@index([companyId, status])
    @@index([userId])
    @@index([customerId])
    @@index([companyId, contractNumber])
}

model AuditLog {
    id         String   @id @default(cuid())
    companyId  String
    userId     String
    operatorId String
    action     String   // SERVICE_SUSPENDED, SERVICE_ACTIVATED, KEY_REGENERATED, BILLING_OVERRIDE, CONTRACT_CREATED, CONTRACT_TERMINATED, LICENSE_DELETED
    entityType String   // LICENSE, CONTRACT, INVOICE, CUSTOMER
    entityId   String
    reason     String   @default("")
    metadata   String?  // JSON stringified details/previous state
    ipAddress  String?
    createdAt  DateTime @default(now())

    company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([companyId, createdAt])
    @@index([companyId, entityType, entityId])
    @@index([userId])
    @@index([action])
}

model PaymentReceipt {
    id              String    @id @default(cuid())
    invoiceId       String
    customerId      String
    uploadedById    String
    fileName        String
    fileSize        Int
    mimeType        String
    fileData        String    // Base64 encoded string
    notes           String?   @default("")
    status          String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
    rejectionReason String?
    reviewedById    String?
    reviewedAt      DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
    uploadedBy      User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

    @@index([invoiceId])
    @@index([customerId])
    @@index([uploadedById])
    @@index([status])
}


